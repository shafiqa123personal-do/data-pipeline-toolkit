# Copy this file to .env and fill in your own values. Never share .env.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional - only needed for --email (Google account > Security > App passwords)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-letter-app-password
REPORT_TO=

DEFAULT_PAGES=50
